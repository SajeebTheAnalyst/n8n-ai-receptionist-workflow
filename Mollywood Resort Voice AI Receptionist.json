      "parameters": {
        "jsCode": "const toolCall = $('Master Webhook').first().json.body?.message?.toolCalls?.[0];\nconst toolCallId = toolCall?.id ?? 'unknown';\nconst rawArgs = toolCall?.function?.arguments ?? '{}';\nlet args = {};\ntry { args = typeof rawArgs === 'string' ? JSON.parse(rawArgs) : rawArgs; } catch(e) { args = {}; }\n\nreturn [{ json: {\n  toolCallId,\n  customer_name: args.customer_name ?? '',\n  phone: args.phone ?? '',\n  query_details: args.query_details ?? ''\n}}];"
      },
