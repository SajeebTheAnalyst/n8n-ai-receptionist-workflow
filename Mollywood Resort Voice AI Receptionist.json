    {
      "parameters": {
        "jsCode": "const toolCallId = $('Master Webhook').first().json.body?.message?.toolCalls?.[0]?.id ?? 'unknown';\n\nconst restaurantRows = $('Read Restaurants').all();\nconst roomRows = $('Read Rooms').all();\nconst eventRows = $('Read Events').all();\nconst faqRows = $('Read FAQ').all();\n\nconst menuText = restaurantRows.map(i => {\n  const r = i.json;\n  return `- ${r['Item Name']} [${r['Category']}] BDT ${r['Price']}: ${r['Description']}`;\n}).join('\\n');\n\nconst roomText = roomRows.map(i => {\n  return Object.entries(i.json).map(([k,v]) => `${k}: ${v}`).join(' | ');\n}).join('\\n');\n\nconst eventText = eventRows.map(i => {\n  return Object.entries(i.json).map(([k,v]) => `${k}: ${v}`).join(' | ');\n}).join('\\n');\n\nconst faqText = faqRows.map(i => {\n  return Object.entries(i.json).map(([k,v]) => `${k}: ${v}`).join(' | ');\n}).join('\\n');\n\nconst fullContext = `=== RESTAURANT MENU ===\\n${menuText}\\n\\n=== ROOMS & COTTAGES ===\\n${roomText}\\n\\n=== EVENTS ===\\n${eventText}\\n\\n=== FAQ ===\\n${faqText}`;\n\nreturn [{ json: { results: [{ toolCallId, result: fullContext }] } }];"
      },
