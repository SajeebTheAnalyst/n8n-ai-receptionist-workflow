    {
      "parameters": {
        "jsCode": "const webhookJson = $('Master Webhook').first().json;\nconst toolCallId = webhookJson.body?.message?.toolCalls?.[0]?.id ?? 'unknown';\nconst rawArgs = webhookJson.body?.message?.toolCalls?.[0]?.function?.arguments ?? '{}';\nlet args = {};\ntry { args = typeof rawArgs === 'string' ? JSON.parse(rawArgs) : rawArgs; } catch(e) { args = {}; }\nconst requestedDate = (args.requested_date ?? '').toString().trim();\n\nconst rows = $('Read Event Planning').all().map(i => i.json);\nlet available = true;\nfor (const row of rows) {\n  const rowDate = (row['Date'] ?? row['Event Date'] ?? '').toString().trim();\n  const rowStatus = (row['Status'] ?? '').toString().toLowerCase().trim();\n  if (rowDate === requestedDate && rowStatus === 'ongoing') { available = false; break; }\n}\n\nconst message = available\n  ? `Great news! ${requestedDate} is available for your event at Mollywood Resort. Please share more details to confirm the booking.`\n  : `Sorry, ${requestedDate} is already booked. Please suggest an alternative date.`;\n\nreturn [{ json: { results: [{ toolCallId, result: JSON.stringify({ available, requested_date: requestedDate, message }) }] } }];"
      },
